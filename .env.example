# Base URL of the Veltrix backend API (no trailing slash).
# Leave empty in dev to use the Vite proxy (same-origin /api -> backend).
# In production set the deployed API origin, e.g. https://veltrix-backend.onrender.com
VITE_API_BASE_URL=

# Dev only: where the Vite proxy forwards /api and /health.
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:3000
